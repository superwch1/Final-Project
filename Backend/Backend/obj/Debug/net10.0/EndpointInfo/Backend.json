{
  "openapi": "3.1.1",
  "info": {
    "title": "Backend | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://0.0.0.0:5000"
    }
  ],
  "paths": {
    "/Device/register/{macAddress}": {
      "get": {
        "tags": [
          "Device"
        ],
        "parameters": [
          {
            "name": "macAddress",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/Device/{macAddress}/state/{turnedOn}": {
      "get": {
        "tags": [
          "Device"
        ],
        "parameters": [
          {
            "name": "macAddress",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "turnedOn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/Device/state": {
      "get": {
        "tags": [
          "Device"
        ],
        "parameters": [
          {
            "name": "X-Mac-Address",
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "longPolling",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Device"
    }
  ]
}